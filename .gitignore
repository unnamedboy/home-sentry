# ============================================
# Home Sentry - Blacklist .gitignore
# Exclude non-code files generated after deployment (based on local-files.txt)
# ============================================

# --- Git ---
.git/

# --- Grafana: plugins, database, runtime ---
grafana/volumes/
grafana/*.db

# --- Home Assistant: storage, backups, database, logs, secrets ---
home-assistant/.storage/
home-assistant/.aarlo/
home-assistant/.ha_run.lock
home-assistant/.HA_VERSION
home-assistant/backups/
home-assistant/home-assistant_v2.db*
home-assistant/home-assistant.log*
home-assistant/secrets.yaml
home-assistant/tts/
home-assistant/bosch_shc/

# --- Homebridge: deps, persist, backups, logs, secrets ---
homebridge/node_modules/
homebridge/persist/
homebridge/backups/
homebridge/config.json
homebridge/.uix-secrets
homebridge/homebridge.log

# --- Python Matter Server: runtime data, credentials ---
python-matter-server/matter-data/

# --- Cloudflare Tunnel: may contain secrets ---
cloudflare-tunnel/config.yml

# --- Deployment-generated list files ---
files.txt
local-files.txt

# --- Common: Node/Python build artifacts, cache, env ---
node_modules/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
*.egg
.env
.env.*
!.env.example

# --- Database files ---
*.db
*.sqlite
*.sqlite3

# --- Logs and lock files ---
*.log
*.lock
